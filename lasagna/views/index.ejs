<%- /* LAYER: Presentation — Lista de tareas */ %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Tareas (MVC)</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 700px; margin: 40px auto; padding: 0 16px; background: #f5f5f5; }
    h1 { color: #1a73e8; }
    a.btn, button.btn {
      display: inline-block; padding: 8px 16px; border-radius: 4px;
      font-size: 14px; cursor: pointer; text-decoration: none; border: none;
    }
    .btn-primary { background: #1a73e8; color: #fff; }
    .btn-danger  { background: #d93025; color: #fff; }
    .btn-success { background: #188038; color: #fff; }
    .btn-secondary { background: #e0e0e0; color: #333; }
    ul { list-style: none; padding: 0; }
    li {
      background: #fff; border-radius: 6px; padding: 16px;
      margin-bottom: 12px; display: flex; align-items: center;
      justify-content: space-between; box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }
    .task-title { font-size: 16px; font-weight: bold; }
    .task-title.done { text-decoration: line-through; color: #888; }
    .task-desc { font-size: 13px; color: #555; margin-top: 4px; }
    .task-date { font-size: 11px; color: #aaa; margin-top: 4px; }
    .actions { display: flex; gap: 8px; flex-shrink: 0; margin-left: 16px; }
    .empty { text-align: center; color: #888; margin-top: 40px; }
  </style>
</head>
<body>

  <h1>Mis Tareas</h1>
  <a href="/tasks/new" class="btn btn-primary">+ Nueva tarea</a>

  <% if (tasks.length === 0) { %>
    <p class="empty">No hay tareas. Crea una para empezar.</p>
  <% } else { %>
    <ul style="margin-top: 24px;">
      <% tasks.forEach(function(task) { %>
        <li>
          <div>
            <div class="task-title <%= task.completed ? 'done' : '' %>">
              <%= task.title %>
            </div>
            <% if (task.description) { %>
              <div class="task-desc"><%= task.description %></div>
            <% } %>
            <div class="task-date"><%= task.created_at %></div>
          </div>

          <div class="actions">
            <!-- Alterna completado/pendiente -->
            <form action="/tasks/<%= task.id %>/toggle" method="POST">
              <button class="btn btn-success">
                <%= task.completed ? 'Reabrir' : 'Completar' %>
              </button>
            </form>

            <!-- Editar -->
            <a href="/tasks/<%= task.id %>/edit" class="btn btn-secondary">Editar</a>

            <!-- Eliminar -->
            <form action="/tasks/<%= task.id %>/delete" method="POST"
                  onsubmit="return confirm('¿Eliminar esta tarea?')">
              <button class="btn btn-danger">Eliminar</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

</body>
</html>
