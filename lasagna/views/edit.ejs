<%- /* LAYER: Presentation — Formulario de edición de tarea */ %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar tarea (MVC)</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 500px; margin: 40px auto; padding: 0 16px; background: #f5f5f5; }
    h1 { color: #1a73e8; }
    label { display: block; margin-top: 16px; font-size: 14px; color: #333; }
    input[type="text"], textarea {
      width: 100%; padding: 10px; margin-top: 6px; border: 1px solid #ccc;
      border-radius: 4px; font-size: 14px; box-sizing: border-box;
    }
    textarea { resize: vertical; min-height: 80px; }
    .actions { margin-top: 24px; display: flex; gap: 12px; }
    button.btn, a.btn {
      padding: 10px 20px; border-radius: 4px; font-size: 14px;
      cursor: pointer; text-decoration: none; border: none;
    }
    .btn-primary   { background: #1a73e8; color: #fff; }
    .btn-secondary { background: #e0e0e0; color: #333; }
  </style>
</head>
<body>

  <h1>Editar tarea</h1>

  <form action="/tasks/<%= task.id %>" method="POST">
    <label for="title">Título <span style="color:red">*</span></label>
    <input type="text" id="title" name="title" value="<%= task.title %>" required autofocus>

    <label for="description">Descripción (opcional)</label>
    <textarea id="description" name="description"><%= task.description %></textarea>

    <div class="actions">
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
      <a href="/" class="btn btn-secondary">Cancelar</a>
    </div>
  </form>

</body>
</html>
